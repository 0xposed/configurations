{
  "name": "@0xposed/eslint-config",
  "version": "0.1.0",
  "description": "Shared ESLint flat configs for Node, TypeScript and Svelte projects.",
  "author": "0xposed",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xposed/configurations.git",
    "directory": "packages/eslint-config"
  },
  "homepage": "https://github.com/0xposed/configurations/tree/master/packages/eslint-config#readme",
  "bugs": {
    "url": "https://github.com/0xposed/configurations/issues"
  },
  "keywords": [
    "0xposed",
    "eslint",
    "eslint-config",
    "flat-config",
    "javascript",
    "typescript",
    "nodejs",
    "svelte",
    "sveltekit"
  ],
  "type": "module",
  "main": "./node.js",
  "exports": {
    ".": "./node.js",
    "./base": "./base.js",
    "./node": "./node.js",
    "./svelte": "./svelte.js",
    "./sorting": "./sorting.js"
  },
  "files": [
    "*.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "eslint": "^9.39.2",
    "svelte": "^5.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "dependencies": {
    "@eslint/js": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.7.0",
    "eslint-plugin-svelte": "^3.22.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "typescript-eslint": "^8.65.0"
  }
}
